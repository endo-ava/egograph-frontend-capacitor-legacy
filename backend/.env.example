BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
CORS_ORIGINS=http://localhost:5174

# Optional API auth
# BACKEND_API_KEY=

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_LLM_MODEL=deepseek/deepseek-v3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_ENABLE_WEB_SEARCH=false

# R2 data access for tool-backed chat
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=egograph
R2_RAW_PATH=raw/
R2_EVENTS_PATH=events/
R2_MASTER_PATH=master/
